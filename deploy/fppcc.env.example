# /etc/fppcc/fppcc.env  — read by fppcc.service. install.sh creates this with a generated DB password.
FPPCC_DATABASE_URL=postgresql+psycopg://fppcc:CHANGE_ME@127.0.0.1:5432/fppcc

# Subnets probed by discovery, in address-preference order (a device on several subnets is reached via the first)
FPPCC_DISCOVERY_SUBNETS=10.100.100.0/24,10.55.1.0/24
FPPCC_DISCOVERY_INTERVAL=600

FPPCC_POLL_INTERVAL=5
FPPCC_SAMPLE_INTERVAL=15

# Dashboard alert thresholds
FPPCC_TEMP_WARN_C=70
FPPCC_CPU_WARN_PCT=90
FPPCC_DISK_WARN_PCT=90

# Backups (stored under FPPCC_DATA_DIR/backups; the systemd unit creates /var/lib/fppcc)
FPPCC_DATA_DIR=/var/lib/fppcc
FPPCC_TIMEZONE=America/New_York
FPPCC_BACKUP_ENABLED=true
FPPCC_BACKUP_TIME=03:00
FPPCC_BACKUP_KEEP_DAILY=14
FPPCC_BACKUP_KEEP_WEEKLY=8
FPPCC_BACKUP_KEEP_MONTHLY=12
